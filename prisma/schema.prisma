generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-1.1.x", "rhel-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  RIDER
}
enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}
enum ContentType {
  HERO
  BLOG
  GALLERY
  VIDEO
  OFFER
  REVIEW
  SOCIAL
  RIDER_PROFILE
}
enum DiscountType {
  PERCENT
  FIXED
}

model User {
  id           String   @id @default(cuid())
  name         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(191)
  passwordHash String   @db.VarChar(255)
  phone        String?  @db.VarChar(30)
  image        String?  @db.VarChar(1024)
  bio          String?  @db.Text
  role         Role     @default(CUSTOMER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions     Session[]
  orders       Order[]  @relation("CustomerOrders")
  deliveries   Order[]  @relation("RiderOrders")
  referrals    Order[]  @relation("ReferralOrders")
  promos       Promo[]
  @@index([role, active])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique @db.Char(64)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([expiresAt])
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique @db.VarChar(191)
  name        String   @db.VarChar(180)
  description String   @db.Text
  category    String   @db.VarChar(100)
  viscosity   String   @db.VarChar(60)
  size        String   @db.VarChar(60)
  pricePaisa  Int
  stock       Int      @default(0)
  image       String   @db.VarChar(1024)
  featured    Boolean  @default(false)
  active      Boolean  @default(true)
  specs       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  items       OrderItem[]
  @@index([active, category])
  @@index([active, featured])
}

model Promo {
  id              String       @id @default(cuid())
  code            String       @unique @db.VarChar(40)
  type            DiscountType @default(PERCENT)
  value           Int
  minOrderPaisa   Int          @default(0)
  maxDiscountPaisa Int?
  maxUses         Int?
  usedCount       Int          @default(0)
  startsAt        DateTime?
  expiresAt       DateTime?
  active          Boolean      @default(true)
  riderId         String?
  rider           User?        @relation(fields: [riderId], references: [id])
  orders          Order[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  @@index([riderId, active])
}

model Order {
  id             String      @id @default(cuid())
  number         String      @unique @db.VarChar(40)
  userId         String
  idempotencyKey String?      @db.VarChar(100)
  user           User        @relation("CustomerOrders", fields: [userId], references: [id])
  riderId        String?
  rider          User?       @relation("RiderOrders", fields: [riderId], references: [id])
  referredById   String?
  referredBy     User?       @relation("ReferralOrders", fields: [referredById], references: [id])
  promoId        String?
  promo          Promo?      @relation(fields: [promoId], references: [id])
  promoCode      String?     @db.VarChar(40)
  subtotalPaisa  Int
  discountPaisa  Int         @default(0)
  shippingPaisa  Int         @default(0)
  totalPaisa     Int
  shipping       Json
  paymentMethod  String      @default("COD") @db.VarChar(30)
  status         OrderStatus @default(PENDING)
  items          OrderItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  @@index([userId, createdAt])
  @@unique([userId, idempotencyKey])
  @@index([riderId, createdAt])
  @@index([referredById, createdAt])
  @@index([promoId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product @relation(fields: [productId], references: [id])
  name           String  @db.VarChar(180)
  image          String  @db.VarChar(1024)
  quantity       Int
  unitPricePaisa Int
  @@index([orderId])
  @@index([productId])
}

model Content {
  id          String      @id @default(cuid())
  type        ContentType
  title       String      @db.VarChar(200)
  slug        String      @unique @db.VarChar(191)
  excerpt     String?     @db.Text
  body        String?     @db.LongText
  image       String?     @db.VarChar(1024)
  mobileImage String?     @db.VarChar(1024)
  youtubeUrl  String?     @db.VarChar(1024)
  videoUrl    String?     @db.VarChar(1024)
  mobileVideoUrl String?  @db.VarChar(1024)
  rating      Int?
  platform    String?     @db.VarChar(30)
  link        String?     @db.VarChar(1024)
  published   Boolean     @default(false)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  @@index([type, published, sortOrder])
}

model Setting {
  key       String   @id @db.VarChar(100)
  value     Json
  updatedAt DateTime @updatedAt
}

model RateLimit {
  key       String   @id @db.VarChar(191)
  count     Int      @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String   @db.VarChar(100)
  entityId  String?  @db.VarChar(191)
  details   Json?
  createdAt DateTime @default(now())
  @@index([actorId, createdAt])
  @@index([createdAt])
}

model VehicleOil {
  id            String   @id @default(cuid())
  make          String   @db.VarChar(80)
  model         String   @db.VarChar(120)
  variant       String   @default("Nepal market") @db.VarChar(100)
  category      String   @default("Motorcycle") @db.VarChar(60)
  marketSource  String   @db.VarChar(1024)
  manualSource  String?  @db.VarChar(1024)
  viscosity     String?  @db.VarChar(80)
  specification String?  @db.VarChar(200)
  productSlug   String?  @db.VarChar(191)
  status        String   @default("PENDING") @db.VarChar(30)
  notes         String   @db.Text
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@unique([make, model, variant])
  @@index([active, make])
}

model DealershipEnquiry {
  id             String   @id @default(cuid())
  name           String   @db.VarChar(120)
  email          String   @db.VarChar(191)
  phone          String   @db.VarChar(30)
  businessName   String   @db.VarChar(180)
  address        String   @db.VarChar(300)
  district       String   @db.VarChar(100)
  dealershipType String   @db.VarChar(60)
  experience     String   @db.VarChar(100)
  message        String   @db.Text
  consent        Boolean
  status         String   @default("NEW") @db.VarChar(30)
  adminNotes     String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([status, createdAt])
}
